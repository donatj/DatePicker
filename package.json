{
  "name": "basic-datepicker",
  "description": "Simple No Framework No Nonsense JavaScript Date Picker",
  "main": "./lib/datepicker.mjs",
  "version": "0.9.1",
  "types": "./lib/datepicker.d.ts",
  "scripts": {
    "test": "mocha test/build.cjs && tsc --ignoreConfig --noEmit --strict --target es2018 --module esnext --moduleResolution bundler test/types-module.ts",
    "build": "tsc --emitDeclarationOnly false --outDir .build && rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donatj/DatePicker.git"
  },
  "keywords": [
    "datepicker",
    "simple"
  ],
  "author": {
    "name": "Jesse G. Donat",
    "email": "donatj@gmail.com",
    "url": "https://donatstudios.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/donatj/DatePicker/issues"
  },
  "homepage": "https://github.com/donatj/DatePicker#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "mocha": "^12.0.3",
    "rollup": "^4.67.4",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "module": "./lib/datepicker.mjs",
  "unpkg": "./lib/datepicker.min.js",
  "exports": {
    ".": {
      "types": "./lib/datepicker.d.ts",
      "import": "./lib/datepicker.mjs"
    },
    "./css/DatePicker.css": "./css/DatePicker.css"
  }
}
